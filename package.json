{
  "name": "mend-ai-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "mend.ai: MongoDB data intelligence layer (Person 1)",
  "scripts": {
    "db:indexes": "node db/scripts/createIndexes.js",
    "db:seed": "node db/scripts/seed.js",
    "db:test": "node db/test/run.js && node db/test/comparables.test.js && node db/test/trends.test.js && node db/test/server.test.js && node db/test/sync.test.js && node db/test/provenance.test.js && node db/test/realdata.test.js",
    "db:test:comparables": "node db/test/comparables.test.js",
    "db:test:trends": "node db/test/trends.test.js",
    "db:test:server": "node db/test/server.test.js",
    "db:test:real": "node db/test/realdata.test.js",
    "db:test:sync": "node db/test/sync.test.js",
    "db:sync": "node db/scripts/syncFromBackend.js",
    "db:pipelines": "node db/scripts/printComparablePipeline.js && node db/scripts/printTrendPipelines.js",
    "engine": "node db/server.js",
    "db:import:riq02": "node db/scripts/importRiq02.js",
    "db:geocode:riq02": "node db/scripts/geocodeRiq02Locations.js",
    "atlas:check": "node db/scripts/atlas.js check",
    "atlas:setup": "node db/scripts/atlas.js setup",
    "db:test:provenance": "node db/test/provenance.test.js",
    "snapshot:frontend": "node db/scripts/snapshotFrontendRents.js",
    "db:demo": "npx --yes tsx db/scripts/loadDemoData.js"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "mongodb": "^6.10.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2"
  }
}
