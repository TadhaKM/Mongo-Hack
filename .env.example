# Copy to .env (git-ignored) and fill in. Never commit real values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=rentcheck_engine          # the MongoDB engine (Node, db/)
BACKEND_MONGODB_DB=rentcheck         # the FastAPI backend (Python)
# Optional: Atlas Model API for embeddings/reranking (only if Vector Search is built)
MONGODB_MODEL_ENDPOINT=ai.mongodb.com
MONGODB_MODEL_API_KEY=
# Engine data policy: real_only (default, blocks synthetic data) or allow_synthetic (development only)
DATA_POLICY=real_only
