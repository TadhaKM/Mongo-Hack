APP_NAME=RentCheck AI API
ENVIRONMENT=development
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=rentcheck
GEOCODER_PROVIDER=nominatim
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=rentcheck-ai-hackathon/0.1
REQUEST_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=3600

# Optional external services
MET_API_BASE_URL=https://opendata2.met.ie/edr
EPA_BASE_URL=https://data.epa.ie

# AI agents (Person 2, mounted at /ai). Put the real key in .env, never in this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
TOOL_CLIENT=inprocess
