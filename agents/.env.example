# Gemini (set only GEMINI_API_KEY; if GOOGLE_API_KEY is also set the SDK prefers it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=20

# Where Person 4's backend runs, and how the agents reach it: http | inprocess | mock
RENTCHECK_API_URL=http://localhost:8000
TOOL_CLIENT=mock
